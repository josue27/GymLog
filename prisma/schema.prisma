generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  passwordHash  String
  googleTokens  String?  // JSON encriptado con AES-256-GCM
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
