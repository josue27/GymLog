# ─── Database (MongoDB Atlas) ───────────────────────────────────────────────
# 1. Crea un cluster M0 gratuito en https://mongodb.com/atlas
# 2. Security > Database Access: crea usuario y contraseña
# 3. Security > Network Access: agrega 0.0.0.0/0
# 4. Connect > Drivers > Prisma: copia la connection string
DATABASE_URL="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/gymlog?retryWrites=true&w=majority"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="generate-a-random-secret-here"

# ─── Google OAuth 2.0 ───────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"

# ─── AES-256-GCM Encryption Key (32 chars) ──────────────────────────────────
ENCRYPTION_KEY="change-me-to-32-characters!!"

# ─── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"